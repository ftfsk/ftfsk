---
import Layout from '../layouts/Layout.astro';
import logoSrc from '../assets/logo.png';
import video1 from '../assets/output.mp4';
import video2 from '../assets/output.mp4';
import portfolioItems from '../data/portfolio-items';
---

<Layout>
  <main class="page-shell">

    <!-- MOBILE DRAWER (behind nav z-index) -->
      <div class="mobile-nav-drawer" id="mobile-drawer" aria-hidden="true">
      <a href="#portfolio" class="drawer-link" data-i18n="portfolio-nav">Πόρτφολιο</a>
      <a href="#services"  class="drawer-link" data-i18n="services-nav">Υπηρεσίες</a>
      <a href="#about"     class="drawer-link" data-i18n="about-nav">Σχετικά</a>
      <a href="#contact"   class="drawer-link drawer-cta" data-i18n="contact-nav">Επικοινωνία</a>
      <div class="mobile-drawer-lang">
        <button class="lang-btn lang-btn-active" data-lang="el">EL</button>
        <button class="lang-btn" data-lang="en">EN</button>
      </div>
    </div>

    <!-- NAVIGATION -->
    <nav class="top-nav" id="top-nav" aria-label="Primary navigation">
      <div class="nav-left">
        <a class="logo-link" href="#home">
          <img class="logo" src={logoSrc.src} alt="Fly Through Films logo" />
        </a>

        <div class="nav-links">
          <a href="#portfolio">
            <span class="nav-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </span>
            <span data-i18n="portfolio-nav">Πόρτφολιο</span>
          </a>
          <a href="#services">
            <span class="nav-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
            </span>
            <span data-i18n="services-nav">Υπηρεσίες</span>
          </a>
          <a href="#about">
            <span class="nav-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3"/><path d="M5.5 21c1.83-3.36 5.1-5 6.5-5s4.67 1.64 6.5 5"/></svg>
            </span>
            <span data-i18n="about-nav">Σχετικά</span>
          </a>
        </div>
      </div>

      <div class="nav-right">
        <div class="lang-switcher" id="lang-switcher">
          <button class="lang-btn lang-btn-active" data-lang="el">EL</button>
          <button class="lang-btn" data-lang="en">EN</button>
        </div>
        <a href="#contact" class="button nav-cta" data-i18n="contact-nav">Επικοινωνία</a>
        <!-- Hamburger (mobile only) -->
        <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero" id="home">
      <video class="hero-video" autoplay muted loop playsinline poster="/background.svg">
        <source src={video1} type="video/mp4" />
      </video>
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <span class="tag">Fly Through Films</span>
        <h1>
          <span class="keyword" aria-live="polite">Εξατομικευμένες Υπηρεσίες</span>
        </h1>
        <p class="hero-lead" data-i18n="heroLead">
          Μοναδικό cinematic περιεχόμενο για σκάφη, real estate και events — σχεδιασμένο για premium brands.
        </p>
        <div class="hero-actions">
          <a href="#portfolio" class="button" data-i18n="view-portfolio">Προβολή Portfolio</a>
          <a href="#contact" class="button button-secondary" data-i18n="contact-nav">Επικοινωνία</a>
        </div>
      </div>
    </section>

    <!-- WHITE SECTION -->
    <section class="white-hero-section">
      <div class="white-hero-copy">
        <span class="tag light" data-i18n="white-tag">Δεν φωτογραφίζουμε απλώς...</span>
        <h2 data-i18n="white-h2">Αποτυπώνουμε τις εικόνες που οι πελάτες μας οραματίζονται.</h2>
        <p data-i18n="white-p">
          Από βίντεο με drones μέχρι branded περιεχόμενο, δημιουργούμε υλικό που αποθεώνει
          premium προϊόντα και κάνει το όραμά σας αδύνατον να προσπεραστεί.
        </p>
      </div>
      <div class="white-hero-media">
        <video class="white-video" autoplay muted loop playsinline poster="/background.svg">
          <source src={video2} type="video/mp4" />
        </video>
      </div>
    </section>

    <!-- DARK CONTENT WRAPPER -->
    <div class="content-bg-wrapper">

      <!-- PORTFOLIO -->
      <section id="portfolio" class="section portfolio-section">
        <div class="section-heading">
          <span class="section-label" data-i18n="portfolio-label">Πόρτφολιο</span>
          <h2 data-i18n="portfolio-h2">Υλικό για σύγχρονες επιχειρήσεις</h2>
        </div>

        <div class="portfolio-scroller" aria-label="Portfolio services">
          <div class="portfolio-track">
            {portfolioItems.map((item) => (
              <article class="card service-card">
                <div class="card-visual" style={`background-image: url('${item.imageUrl}')`} aria-label={item.imageFile}></div>
                <div class="card-copy">
                  <h3 class="portfolio-title" data-title-el={item.title} data-title-en={item.title_en ?? item.title}>{item.title}</h3>
                  <p class="portfolio-desc" data-desc-el={item.description} data-desc-en={item.description_en ?? item.description}>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section id="services" class="section section-service-grid">
        <div class="section-heading">
          <span class="section-label" data-i18n="services-label">Υπηρεσίες</span>
          <h2 data-i18n="services-h2">Τι σας προσφέρουμε</h2>
        </div>
        <div class="services-drone" aria-hidden="true">
          <svg viewBox="0 0 120 80" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <g class="drone-group" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
              <path d="M30 20 L50 30" />
              <path d="M90 20 L70 30" />
              <path d="M30 60 L50 50" />
              <path d="M90 60 L70 50" />
              <circle class="rotor r1" cx="26" cy="18" r="7" />
              <circle class="rotor r2" cx="94" cy="18" r="7" />
              <circle class="rotor r3" cx="26" cy="62" r="7" />
              <circle class="rotor r4" cx="94" cy="62" r="7" />
              <rect class="drone-body" x="44" y="28" width="32" height="24" rx="5" />
              <circle class="camera" cx="60" cy="40" r="5" fill="rgba(232,160,32,0.96)" stroke="none" />
              <path d="M10 44c20-14 40-16 70-6" opacity="0.12" />
            </g>
          </svg>
        </div>
        <div class="service-grid">
          <div class="service-box">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.9L15 14"/><rect x="1" y="6" width="15" height="12" rx="2"/></svg>
            </div>
            <h3 data-i18n="aerial-video">Aerial Videography</h3>
            <p data-i18n="aerial-desc">Σταθερές cinematic λήψεις για promos, commercials και digital campaigns.</p>
          </div>
          <div class="service-box">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M3 9l2-4h14l2 4v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9z"/></svg>
            </div>
            <h3 data-i18n="drone-photo">Drone Photography</h3>
            <p data-i18n="drone-desc">Εναέριες φωτογραφίες υψηλής ανάλυσης για print, web και social media.</p>
          </div>
          <div class="service-box">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4v16M17 4v16M3 8h4m10 0h4M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
            </div>
            <h3 data-i18n="brand-films">Brand Films</h3>
            <p data-i18n="brand-desc">Cinematic films με αφηγηματικό χαρακτήρα για premium brand identity.</p>
          </div>
          <div class="service-box">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <h3 data-i18n="event-coverage">Event Coverage</h3>
            <p data-i18n="event-desc">Ολοκληρωμένη κάλυψη με video και φωτογραφία για κάθε live experience.</p>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="section about-section">
        <div class="about-inner">
          <div class="about-text">
            <span class="section-label" data-i18n="about-label">Σχετικά</span>
            <h2 data-i18n="about-h2">Drone crew φτιαγμένο για visual storytelling</h2>
            <p data-i18n="about-p">
              Συνδυάζουμε επαγγελματικές πτητικές πρακτικές με δημιουργική κατεύθυνση για να παραδώσουμε
              υψηλής ποιότητας εναέριο περιεχόμενο. Από το concept μέχρι το τελικό edit,
              η δουλειά μας είναι προσαρμοσμένη για brands που θέλουν να ξεχωρίζουν.
            </p>
            <ul class="about-list">
              <li><span class="list-dot"></span><span data-i18n="about-list1">Επαγγελματίες με Πιστοποίηση EASA</span></li>
              <li><span class="list-dot"></span><span data-i18n="about-list2">Υψηλής Ποιότητας Εξοπλισμός</span></li>
              <li><span class="list-dot"></span><span data-i18n="about-list3">Από αισθητικά video μέχρι heavy - duty εργασίες</span></li>
            </ul>
          </div>
          <div class="about-visual"></div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="section contact-section">
        <div class="contact-inner">
          <span class="section-label light" data-i18n="contact-label">Επικοινωνία</span>
          <h2 data-i18n="contact-h2">Σου άρεσε η δουλειά και η φιλοσοφία μας;</h2>
          <p data-i18n="contact-p">
            Μην διστάσεις να επικοινωνήσεις με email ή να μας βρεις στις παρακάτω πλατφόρμες.
          </p>
          <div class="contact-actions">
            <a href="mailto:flythroughfilms@gmail.com" class="button contact-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              flythroughfilms@gmail.com
            </a>
            <a href="https://wa.me/306987945665" target="_blank" rel="noopener noreferrer" class="button contact-btn contact-whatsapp">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378c-3.055 2.364-3.905 6.75-1.904 10.23 1.93 3.243 6.239 4.43 9.861 2.854 3.531-1.517 5.956-5.396 5.039-9.276-1.127-4.878-6.027-8.066-11.027-7.193-.214.025-.428.025-.642.025z"/></svg>
              <span data-i18n="whatsapp">WhatsApp</span>
            </a>
            <div class="contact-social">
              <a href="https://www.instagram.com/yourprofile" target="_blank" rel="noopener noreferrer" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><path d="M16 11.37a4 4 0 1 1-7.99.63A4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
                <span data-i18n="instagram">Instagram</span>
              </a>
              <a href="https://www.youtube.com/yourchannel" target="_blank" rel="noopener noreferrer" class="social-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29.44 29.44 0 0 0 1 12a29.44 29.44 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29.44 29.44 0 0 0 23 12a29.44 29.44 0 0 0-.46-5.58z"/><path d="M10 15l5-3-5-3v6z"/></svg>
                <span data-i18n="youtube">YouTube</span>
              </a>
            </div>
          </div>
        </div>
      </section>

    </div><!-- end .content-bg-wrapper -->

    <!-- FOOTER -->
    <footer class="footer">
      <p data-i18n="footer">Fly Through Films © 2026 — Cinematic Aerial Media</p>
    </footer>
  </main>

  <script>
    /* ── Language configuration ── */
    const translations = {
      el: {
        portfolio: 'Πόρτφολιο',
        services: 'Υπηρεσίες',
        about: 'Σχετικά',
        contact: 'Επικοινωνία',
        heroTag: 'Fly Through Films',
        heroKeywords: ['Εξατομικευμένες Υπηρεσίες', 'Τέχνη και Επιχείρηση', 'Αύξηση Πωλήσεων', 'Δημιουργία Αναμνήσεων', 'Κάλυψη Εκδηλώσεων', 'Προώθηση Προϊόντων'],
        heroLead: 'Μοναδικό cinematic περιεχόμενο για σκάφη, real estate και events — σχεδιασμένο για premium brands.',
        viewPortfolio: 'Προβολή Portfolio',
        whiteTag: 'Δεν φωτογραφίζουμε απλώς...',
        whiteH2: 'Αποτυπώνουμε τις εικόνες που οι πελάτες μας οραματίζονται.',
        whiteP: 'Από βίντεο με drones μέχρι branded περιεχόμενο, δημιουργούμε υλικό που αποθεώνει premium προϊόντα και κάνει το όραμά σας αδύνατον να προσπεραστεί.',
        portfolioLabel: 'Πόρτφολιο',
        portfolioH2: 'Υλικό για σύγχρονες επιχειρήσεις',
        servicesLabel: 'Υπηρεσίες',
        servicesH2: 'Τι σας προσφέρουμε',
        aerialVideo: 'Aerial Videography',
        aerialVideoDesc: 'Σταθερές cinematic λήψεις για promos, commercials και digital campaigns.',
        dronePhoto: 'Drone Photography',
        dronePhotoDesc: 'Εναέριες φωτογραφίες υψηλής ανάλυσης για print, web και social media.',
        brandFilms: 'Brand Films',
        brandFilmsDesc: 'Cinematic films με αφηγηματικό χαρακτήρα για premium brand identity.',
        eventCoverage: 'Event Coverage',
        eventCoverageDesc: 'Ολοκληρωμένη κάλυψη με video και φωτογραφία για κάθε live experience.',
        aboutLabel: 'Σχετικά',
        aboutH2: 'Drone crew φτιαγμένο για visual storytelling',
        aboutP: 'Συνδυάζουμε επαγγελματικές πτητικές πρακτικές με δημιουργική κατεύθυνση για να παραδώσουμε υψηλής ποιότητας εναέριο περιεχόμενο. Από το concept μέχρι το τελικό edit, η δουλειά μας είναι προσαρμοσμένη για brands που θέλουν να ξεχωρίζουν.',
        aboutList1: 'Επαγγελματίες με Πιστοποίηση EASA',
        aboutList2: 'Υψηλής Ποιότητας Εξοπλισμός',
        aboutList3: 'Από αισθητικά video μέχρι heavy - duty εργασίες',
        contactLabel: 'Επικοινωνία',
        contactH2: 'Σου άρεσε η δουλειά και η φιλοσοφία μας;',
        contactP: 'Μην διστάσεις να επικοινωνήσεις με email ή να μας βρεις στις παρακάτω πλατφόρμες.',
        whatsapp: 'WhatsApp',
        instagram: 'Instagram',
        youtube: 'YouTube',
        footer: 'Fly Through Films © 2026 — Cinematic Aerial Media'
      },
      en: {
        portfolio: 'Portfolio',
        services: 'Services',
        about: 'About',
        contact: 'Contact',
        heroTag: 'Fly Through Films',
        heroKeywords: ['Customized Services', 'Art & Business', 'Increase Sales', 'Create Memories', 'Event Coverage', 'Promote Products'],
        heroLead: 'Unique cinematic content for yachts, real estate and events — designed for premium brands.',
        viewPortfolio: 'View Portfolio',
        whiteTag: 'We don\'t just photograph...',
        whiteH2: 'We capture the images your clients dream about.',
        whiteP: 'From drone videos to branded content, we create material that glorifies premium products and makes your vision impossible to ignore.',
        portfolioLabel: 'Portfolio',
        portfolioH2: 'Content for modern businesses',
        servicesLabel: 'Services',
        servicesH2: 'What we offer',
        aerialVideo: 'Aerial Videography',
        aerialVideoDesc: 'Smooth cinematic shots for promos, commercials and digital campaigns.',
        dronePhoto: 'Drone Photography',
        dronePhotoDesc: 'High-resolution aerial photography for print, web and social media.',
        brandFilms: 'Brand Films',
        brandFilmsDesc: 'Cinematic films with narrative character for premium brand identity.',
        eventCoverage: 'Event Coverage',
        eventCoverageDesc: 'Complete coverage with video and photography for every live experience.',
        aboutLabel: 'About',
        aboutH2: 'Drone crew built for visual storytelling',
        aboutP: 'We combine professional flight practices with creative direction to deliver high-quality aerial content. From concept to final edit, our work is tailored for brands that want to stand out.',
        aboutList1: 'Certified professional drone pilots',
        aboutList2: 'High-quality equipment',
        aboutList3: 'From aesthetic videos to heavy-duty work',
        contactLabel: 'Contact',
        contactH2: 'Did you like our work and philosophy?',
        contactP: 'Feel free to contact us by email or find us on the platforms below.',
        whatsapp: 'WhatsApp',
        instagram: 'Instagram',
        youtube: 'YouTube',
        footer: 'Fly Through Films © 2026 — Cinematic Aerial Media'
      }
    };

    let currentLang = localStorage.getItem('lang') || 'el';

    const setLanguage = (lang) => {
      currentLang = lang;
      localStorage.setItem('lang', lang);
      updatePageText();
      updateLangButtons();
    };

    const updateLangButtons = () => {
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('lang-btn-active', btn.dataset.lang === currentLang);
      });
    };

    const updatePageText = () => {
      const t = translations[currentLang];
      const map = {
        '[data-i18n="portfolio-nav"]': t.portfolio,
        '[data-i18n="services-nav"]':  t.services,
        '[data-i18n="about-nav"]':     t.about,
        '[data-i18n="contact-nav"]':   t.contact,
        '[data-i18n="view-portfolio"]': t.viewPortfolio,
        '[data-i18n="white-tag"]':     t.whiteTag,
        '[data-i18n="white-h2"]':      t.whiteH2,
        '[data-i18n="white-p"]':       t.whiteP,
        '[data-i18n="portfolio-label"]': t.portfolioLabel,
        '[data-i18n="portfolio-h2"]':  t.portfolioH2,
        '[data-i18n="services-label"]': t.servicesLabel,
        '[data-i18n="services-h2"]':   t.servicesH2,
        '[data-i18n="aerial-video"]':  t.aerialVideo,
        '[data-i18n="aerial-desc"]':   t.aerialVideoDesc,
        '[data-i18n="drone-photo"]':   t.dronePhoto,
        '[data-i18n="drone-desc"]':    t.dronePhotoDesc,
        '[data-i18n="brand-films"]':   t.brandFilms,
        '[data-i18n="brand-desc"]':    t.brandFilmsDesc,
        '[data-i18n="event-coverage"]': t.eventCoverage,
        '[data-i18n="event-desc"]':    t.eventCoverageDesc,
        '[data-i18n="about-label"]':   t.aboutLabel,
        '[data-i18n="about-h2"]':      t.aboutH2,
        '[data-i18n="about-p"]':       t.aboutP,
        '[data-i18n="about-list1"]':   t.aboutList1,
        '[data-i18n="about-list2"]':   t.aboutList2,
        '[data-i18n="about-list3"]':   t.aboutList3,
        '[data-i18n="contact-label"]': t.contactLabel,
        '[data-i18n="contact-h2"]':    t.contactH2,
        '[data-i18n="contact-p"]':     t.contactP,
        '[data-i18n="footer"]':        t.footer,
      };
      for (const [sel, val] of Object.entries(map)) {
        document.querySelectorAll(sel).forEach(el => el.textContent = val);
      }
      // update portfolio item titles/descriptions from data attributes
      document.querySelectorAll('.portfolio-title').forEach(el => {
        const elNode = el;
        const val = currentLang === 'en' ? (elNode.dataset.titleEn || elNode.getAttribute('data-title-en')) : (elNode.dataset.titleEl || elNode.getAttribute('data-title-el'));
        if (val) elNode.textContent = val;
      });
      document.querySelectorAll('.portfolio-desc').forEach(el => {
        const elNode = el;
        const val = currentLang === 'en' ? (elNode.dataset.descEn || elNode.getAttribute('data-desc-en')) : (elNode.dataset.descEl || elNode.getAttribute('data-desc-el'));
        if (val) elNode.textContent = val;
      });
      // update initial keyword immediately
      if (keywordEl) {
        const kws = translations[currentLang]?.heroKeywords;
        if (kws && kws.length) keywordEl.textContent = kws[0];
      }
    };

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => setLanguage(btn.dataset.lang));
    });

    updateLangButtons();
    updatePageText();

    /* ── Keyword cycling ── */
    const keywordEl = document.querySelector<HTMLElement>('.hero-copy .keyword');
    let keywordIndex = 0;

    const getKeywords = () => translations[currentLang].heroKeywords;

    const updateKeyword = () => {
      if (!keywordEl) return;
      keywordEl.classList.add('fade-out');
      window.setTimeout(() => {
        const kws = getKeywords();
        keywordIndex = (keywordIndex + 1) % kws.length;
        keywordEl.textContent = kws[keywordIndex];
        keywordEl.classList.remove('fade-out');
      }, 400);
    };
    if (keywordEl) window.setInterval(updateKeyword, 3000);

    /* ── Nav visibility: show only while hero is in view ── */
    const heroEl = document.querySelector<HTMLElement>('.hero');
    const navEl  = document.querySelector<HTMLElement>('#top-nav');

    if (heroEl && navEl && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach(e => navEl.classList.toggle('nav-hidden', !e.isIntersecting));
      }, { threshold: 0.05 }).observe(heroEl);
    }

    /* ── Hamburger / mobile drawer ── */
    const hamburger = document.getElementById('hamburger');
    const drawer    = document.getElementById('mobile-drawer');

    const closeDrawer = () => {
      hamburger?.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
      drawer?.classList.remove('open');
      drawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    hamburger?.addEventListener('click', () => {
      const isOpen = drawer?.classList.contains('open');
      if (isOpen) {
        closeDrawer();
      } else {
        hamburger.classList.add('open');
        hamburger.setAttribute('aria-expanded', 'true');
        drawer?.classList.add('open');
        drawer?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    });

    // Close on drawer link click
    drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));

    // Close on Escape key
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

    /* ── Portfolio auto-scroll with seamless loop ── */
    (() => {
      const scroller = document.querySelector<HTMLElement>('.portfolio-scroller');
      const track    = scroller?.querySelector<HTMLElement>('.portfolio-track');
      if (!scroller || !track) return;

      Array.from(track.children).forEach(item => track.appendChild(item.cloneNode(true)));

      let lastTime  = performance.now();
      let paused    = false;
      let loopWidth = 0;

      const updateLoopWidth = () => { loopWidth = track.scrollWidth / 2; };

      scroller.addEventListener('wheel', (e: WheelEvent) => {
        if (Math.abs(e.deltaY) > 0) { e.preventDefault(); scroller.scrollLeft += e.deltaY * 0.9; }
      }, { passive: false });

      // Touch support for dragging the scroller
      let touchStartX = 0;
      let scrollStartLeft = 0;
      scroller.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartX      = e.touches[0].clientX;
        scrollStartLeft  = scroller.scrollLeft;
        paused = true;
      }, { passive: true });
      scroller.addEventListener('touchmove', (e: TouchEvent) => {
        const dx = touchStartX - e.touches[0].clientX;
        scroller.scrollLeft = scrollStartLeft + dx;
      }, { passive: true });
      scroller.addEventListener('touchend', () => {
        window.setTimeout(() => { paused = false; }, 800);
      });

      scroller.addEventListener('mouseenter', () => { paused = true;  });
      scroller.addEventListener('mouseleave', () => { paused = false; });

      const step = (time: number) => {
        if (!paused) {
          scroller.scrollLeft += (80 * (time - lastTime)) / 1000;
          if (scroller.scrollLeft >= loopWidth) scroller.scrollLeft -= loopWidth;
        }
        lastTime = time;
        requestAnimationFrame(step);
      };

      window.addEventListener('resize', updateLoopWidth);
      updateLoopWidth();
      requestAnimationFrame(step);
    })();
  </script>
</Layout>

